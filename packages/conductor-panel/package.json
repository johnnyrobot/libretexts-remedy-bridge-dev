{
  "name": "@libretexts/remedy-conductor-panel",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Staff UI for LibreTexts Remedy \u2014 scan, preview, apply.",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test server/*.test.ts",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/server.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@libretexts/remedy-core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
