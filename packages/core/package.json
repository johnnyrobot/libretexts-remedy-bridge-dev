{
  "name": "@libretexts/remedy-core",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Accessibility scan + fix library for LibreTexts CXone Expert pages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libretexts/cxone-expert-node": "1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "axe-core": "^4.10.2",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "ipaddr.js": "2.5.0",
    "jsdom": "^25.0.1",
    "parse5": "^7.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
