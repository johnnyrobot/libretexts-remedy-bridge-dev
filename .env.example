# LibreTexts Remedy — environment template
# Copy to .env and fill in. .env is git-ignored.
# NEVER commit real secrets.

# --- CXone Expert (MindTouch / Deki) ---
# Hostname of the target instance (no protocol).
SERVER_DOMAIN=dev.libretexts.org
CXONE_INTEGRATION_ENABLED=false
CXONE_ALLOWED_HOST=dev.libretexts.org
CXONE_ALLOWED_ROOT=Sandboxes/johnnyphung

# Service-account credentials for signed X-Deki-Token auth.
# Scope: Sandboxes namespace only for MVP.
SERVER_KEY=
SERVER_SECRET=
SERVER_USER=

# --- LLM provider (used by rule fixers) ---
# One client, OpenAI-compatible payload, any of these providers.
# Set REMEDY_LLM_PROVIDER to pick one.
REMEDY_LLM_PROVIDER=openrouter            # openai | openrouter | ollama-cloud | ollama-local | gemini-compat | custom
# REMEDY_LLM_BASE_URL=                    # only needed for provider=custom
# REMEDY_LLM_API_KEY=                     # takes precedence over the provider-specific key below
REMEDY_TEXT_MODEL=                        # leave blank for provider default
REMEDY_VISION_MODEL=                      # leave blank for provider default

# Provider-specific keys (pick the ones you use)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_KEY=                           # Ollama Cloud subscription
GEMINI_API_KEY=
# For another OpenAI-compatible provider, use custom plus base URL and key.

# Optional cross-provider failover for BOTH text and vision. Triggered by
# unavailable models, authentication errors, rate limits, network errors,
# exhausted retries, and empty/truncated answers. Does not bypass refusals.
# Example Conductor demo: primary GLM on Ollama Cloud, fallback Luna high.
# REMEDY_LLM_PROVIDER=ollama-cloud
# REMEDY_TEXT_MODEL=glm-5.3-flash:cloud
# REMEDY_VISION_MODEL=glm-5.3-flash:cloud
# REMEDY_REASONING_TOKEN_BUDGET=8192
# REMEDY_FALLBACK_PROVIDER=openai
# REMEDY_FALLBACK_BASE_URL=https://api.openai.com/v1
# REMEDY_FALLBACK_TEXT_MODEL=gpt-5.6-luna
# REMEDY_FALLBACK_VISION_MODEL=gpt-5.6-luna
# REMEDY_FALLBACK_REASONING_EFFORT=high
# REMEDY_FALLBACK_REASONING_TOKEN_BUDGET=8192
# Fallback uses OPENAI_API_KEY for provider=openai. Optional dedicated override:
# REMEDY_FALLBACK_API_KEY=
# Reasoning allowance is added to each fixer's answer-token limit. It is a
# completion ceiling, not a guarantee of answer length or tokens consumed.

# Optional OpenRouter attribution headers (shown in their dashboard)
REMEDY_OPENROUTER_REFERER=https://github.com/libretexts
REMEDY_OPENROUTER_APP=libretexts-remedy

# --- Remedy behavior ---
# Compatibility copy of the immutable owner-only write policy. Any broader or
# different value makes the enabled integration report misconfigured.
REMEDY_WRITE_ALLOWLIST=^Sandboxes/johnnyphung(?:/|$)

# Path for the append-only audit log of every apply.
REMEDY_AUDIT_LOG=.remedy/audit.log

# Conductor panel API server (local staff tool). Binds to loopback by default;
# change the host only deliberately, and add auth before exposing it off-host.
CONDUCTOR_API_HOST=127.0.0.1
# CONDUCTOR_API_PORT=5175
# Max accepted request body size (bytes) for the panel API.
REMEDY_MAX_REQUEST_BYTES=5000000

# SSRF guard for outbound image fetches. Empty = allow any PUBLIC host (private,
# loopback, link-local and cloud-metadata addresses are always blocked). Set a
# comma-separated host-suffix list for a strict positive allowlist, e.g.
# REMEDY_IMAGE_FETCH_ALLOWLIST=libretexts.org,cdn.mathpix.com
REMEDY_IMAGE_FETCH_ALLOWLIST=

# Set to 1 for verbose Remedy debug logging (safe — never prints secrets).
DEBUG=
# Set to 1 ONLY to debug the CXone SDK itself. This can print the signed
# X-Deki-Token credential to the console — keep it off outside local debugging.
REMEDY_SDK_DEBUG=

# Optional private rendered-page scanner; never expose its port publicly.
RENDER_SCANNER_URL=
RENDER_SCANNER_TOKEN=

# Explicit limited Bridge profile; omitted value preserves the existing full-write profile.
# review-only requires private service authentication and authorized CXone read configuration.
# See docs/release/lt-174-review-only-profile.md; automatic apply/restore remain unavailable.
REMEDY_BRIDGE_PROFILE=full-write
# Optional historical status in review-only (alongside existing ledger/fence/epoch settings):
# REMEDY_OPERATION_STATUS_ISSUER=urn:libretexts:conductor:your-environment
